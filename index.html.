                    { text: "Bình thường, ngủ ngon giấc", score: 0 },
                    { text: "Hay trằn trọc, đôi khi đau đầu/đau bụng nhẹ", score: 1 },
                    { text: "Mất ngủ thường xuyên, luôn mệt mỏi và âu lo", score: 2 }
                ]
            },
            {
                question: "5. Khi gặp phải tình huống khó chịu hoặc bị bắt nạt, bạn có tìm được người tin cậy (thầy cô, phụ huynh, bạn thân) để chia sẻ không?",
                options: [
                    { text: "Có, tôi luôn chia sẻ và nhận được sự giúp đỡ", score: 0 },
                    { text: "Tôi có ngần ngại nhưng có thể chia sẻ", score: 1 },
                    { text: "Không, tôi hoàn toàn cô độc và phải chịu đựng một mình", score: 2 }
                ]
            }
        ];

        let currentQuizIndex = 0;
        let totalQuizScore = 0;

        function startQuiz() {
            currentQuizIndex = 0;
            totalQuizScore = 0;
            document.getElementById('quiz-intro').classList.add('hidden');
            document.getElementById('quiz-result').classList.add('hidden');
            document.getElementById('quiz-main').classList.remove('hidden');
            renderQuizQuestion();
        }

        function renderQuizQuestion() {
            const q = quizQuestions[currentQuizIndex];
            const progressPct = ((currentQuizIndex + 1) / quizQuestions.length) * 100;

            document.getElementById('quiz-progress-text').innerText = `Câu hỏi ${currentQuizIndex + 1} / ${quizQuestions.length}`;
            document.getElementById('quiz-bar').style.width = progressPct + '%';

            let optionsHtml = '';
            q.options.forEach((opt, idx) => {
                optionsHtml += `
                    <button onclick="answerQuiz(${opt.score})" class="w-full text-left bg-slate-50 hover:bg-hope-50 hover:border-hope-500 border border-slate-200 p-4 rounded-xl text-sm font-medium transition flex items-center justify-between group">
                        <span>${opt.text}</span>
                        <i class="fa-solid fa-chevron-right text-xs text-slate-400 group-hover:text-hope-600"></i>
                    </button>
                `;
            });

            document.getElementById('quiz-question-box').innerHTML = `
                <h4 class="font-bold text-slate-900 text-base mb-4">${q.question}</h4>
                <div class="space-y-3">${optionsHtml}</div>
            `;
        }

        function answerQuiz(score) {
            totalQuizScore += score;
            currentQuizIndex++;
            if (currentQuizIndex < quizQuestions.length) {
                renderQuizQuestion();
            } else {
                showQuizResult();
            }
        }

        function showQuizResult() {
            document.getElementById('quiz-main').classList.add('hidden');
            const resultBox = document.getElementById('quiz-result');
            resultBox.classList.remove('hidden');

            const iconEl = document.getElementById('quiz-result-icon');
            const titleEl = document.getElementById('quiz-result-title');
            const descEl = document.getElementById('quiz-result-desc');

            if (totalQuizScore <= 3) {
                iconEl.className = 'w-16 h-16 rounded-full bg-emerald-100 text-emerald-600 mx-auto flex items-center justify-center text-3xl';
                iconEl.innerHTML = '<i class="fa-solid fa-face-smile"></i>';
                titleEl.innerText = 'Tinh thần ổn định & Môi trường lành mạnh';
                descEl.innerText = 'Chúc mừng bạn! Hiện tại bạn đang có tâm lý khá vững vàng và môi trường học đường tương đối an toàn. Hãy tiếp tục duy trì các mối quan hệ tích cực và sẵn sàng giúp đỡ những bạn học sinh khác nhé.';
            } else if (totalQuizScore <= 7) {
                iconEl.className = 'w-16 h-16 rounded-full bg-amber-100 text-amber-600 mx-auto flex items-center justify-center text-3xl';
                iconEl.innerHTML = '<i class="fa-solid fa-face-meh"></i>';
                titleEl.innerText = 'Có dấu hiệu căng thẳng hoặc rủi ro tiềm ẩn';
                descEl.innerText = 'Kết quả cho thấy bạn đang trải qua một số áp lực hoặc có dấu hiệu không thoải mái ở trường học. Bạn nên chia sẻ tâm sự với bạn bè thân thiết, thầy cô hoặc trò chuyện ngay với Trợ lý AI để được hướng dẫn giải tỏa kịp thời.';
            } else {
                iconEl.className = 'w-16 h-16 rounded-full bg-rose-100 text-rose-600 mx-auto flex items-center justify-center text-3xl';
                iconEl.innerHTML = '<i class="fa-solid fa-face-frown-open"></i>';
                titleEl.innerText = 'Cảnh báo: Tổn thương tâm lý hoặc nguy cơ bạo lực cao';
                descEl.innerText = 'Bạn đang chịu nhiều áp lực và có thể là nạn nhân của bạo lực học đường. Xin đừng chịu đựng một mình! Hãy sử dụng ngay tính năng Báo Cáo Ẩn Danh để thông báo cho nhà trường hoặc liên hệ Tổng đài bảo vệ trẻ em 111 để được bảo vệ khẩn cấp.';
            }
        }

        function resetQuiz() {
            startQuiz();
        }
    </script>
