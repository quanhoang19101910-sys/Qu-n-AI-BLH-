<!DOCTYPE html>
<html lang="vi" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sáng Kiến AI - Giải Pháp Chống Bạo Lực Học Đường</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Inter', 'sans-serif'] },
                    colors: {
                        hope: {
                            50: '#f0f9ff',
                            100: '#e0f2fe',
                            500: '#0ea5e9',
                            600: '#0284c7',
                            700: '#0369a1',
                            900: '#0c4a6e',
                        },
                        safe: {
                            50: '#ecfdf5',
                            500: '#10b981',
                            600: '#059669',
                        }
                    }
                }
            }
        }
    </script>
</head>
<body class="h-full bg-slate-50 text-slate-800 flex flex-col font-sans">

    <header class="bg-white border-b border-slate-200 sticky top-0 z-50 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center space-x-3 cursor-pointer" onclick="switchTab('home')">
                <div class="w-10 h-10 rounded-xl bg-hope-600 flex items-center justify-center text-white shadow-md">
                    <i class="fa-solid fa-shield-heart text-xl"></i>
                </div>
                <div>
                    <h1 class="font-bold text-lg text-slate-900 tracking-tight">Vững Bước Xanh</h1>
                    <p class="text-xs text-slate-500">Trợ lý AI & Hỗ trợ học đường an toàn</p>
                </div>
            </div>
            
            <!-- Navigation Links -->
            <nav class="hidden md:flex space-x-1 lg:space-x-2">
                <button onclick="switchTab('home')" id="nav-home" class="nav-btn px-3 py-2 rounded-lg text-sm font-medium transition text-hope-700 bg-hope-50">Trang chủ</button>
                <button onclick="switchTab('ai-chat')" id="nav-ai-chat" class="nav-btn px-3 py-2 rounded-lg text-sm font-medium transition text-slate-600 hover:bg-slate-100">Tư Vấn AI 24/7</button>
                <button onclick="switchTab('report')" id="nav-report" class="nav-btn px-3 py-2 rounded-lg text-sm font-medium transition text-slate-600 hover:bg-slate-100">Báo Cáo Ẩn Danh</button>
                <button onclick="switchTab('toolkits')" id="nav-toolkits" class="nav-btn px-3 py-2 rounded-lg text-sm font-medium transition text-slate-600 hover:bg-slate-100">Bộ Công Cụ</button>
                <button onclick="switchTab('quiz')" id="nav-quiz" class="nav-btn px-3 py-2 rounded-lg text-sm font-medium transition text-slate-600 hover:bg-slate-100">Đánh Giá Tâm Lý</button>
            </nav>

            <!-- Emergency Hotline Button -->
            <div class="flex items-center space-x-2">
                <a href="tel:111" class="inline-flex items-center space-x-2 bg-rose-50 text-rose-700 hover:bg-rose-100 border border-rose-200 px-3 py-2 rounded-lg text-xs font-semibold transition shadow-sm">
                    <i class="fa-solid fa-phone-volume animate-bounce text-rose-500"></i>
                    <span>Đường dây nóng: 111</span>
                </a>
                <button onclick="toggleMobileMenu()" class="md:hidden p-2 rounded-lg text-slate-600 hover:bg-slate-100">
                    <i class="fa-solid fa-bars text-xl"></i>
                </button>
            </div>
        </div>

        <!-- Mobile Menu Drawer -->
        <div id="mobile-menu" class="hidden md:hidden bg-white border-b border-slate-200 px-4 pt-2 pb-4 space-y-1">
            <button onclick="switchTab('home'); toggleMobileMenu();" class="block w-full text-left px-3 py-2 rounded-lg text-sm font-medium text-slate-700 hover:bg-slate-100">Trang chủ</button>
            <button onclick="switchTab('ai-chat'); toggleMobileMenu();" class="block w-full text-left px-3 py-2 rounded-lg text-sm font-medium text-slate-700 hover:bg-slate-100">Tư Vấn AI 24/7</button>
            <button onclick="switchTab('report'); toggleMobileMenu();" class="block w-full text-left px-3 py-2 rounded-lg text-sm font-medium text-slate-700 hover:bg-slate-100">Báo Cáo Ẩn Danh</button>
            <button onclick="switchTab('toolkits'); toggleMobileMenu();" class="block w-full text-left px-3 py-2 rounded-lg text-sm font-medium text-slate-700 hover:bg-slate-100">Bộ Công Cụ</button>
            <button onclick="switchTab('quiz'); toggleMobileMenu();" class="block w-full text-left px-3 py-2 rounded-lg text-sm font-medium text-slate-700 hover:bg-slate-100">Đánh Giá Tâm Lý</button>
        </div>
    </header>

    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 flex flex-col">

        <!-- TAB 1: HOME -->
        <section id="tab-home" class="tab-content flex-1 flex flex-col space-y-8">
            <!-- Hero Banner -->
            <div class="relative rounded-3xl bg-gradient-to-r from-hope-700 to-teal-600 text-white p-8 sm:p-12 overflow-hidden shadow-xl">
                <div class="absolute -right-10 -bottom-10 opacity-10 text-9xl">
                    <i class="fa-solid fa-hands-holding-child"></i>
                </div>
                <div class="max-w-2xl relative z-10 space-y-4">
                    <span class="inline-flex items-center space-x-2 bg-white/15 backdrop-blur-md px-3 py-1 rounded-full text-xs font-medium text-hope-100 border border-white/20">
                        <i class="fa-solid fa-sparkles text-amber-300"></i>
                        <span>Nền tảng hỗ trợ học đường thông minh</span>
                    </span>
                    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight leading-tight">
                        Cùng Nhau Xây Dựng Môi Trường Học Đường An Toàn & Lành Mạnh
                    </h2>
                    <p class="text-hope-100 text-sm sm:text-base leading-relaxed">
                        Nơi bạn được lắng nghe, bảo vệ tuyệt đối và cung cấp giải pháp ứng phó thông minh với mọi hình thức bạo lực học đường (thể xác, tinh thần, không gian mạng).
                    </p>
                    <div class="pt-2 flex flex-wrap gap-3">
                        <button onclick="switchTab('ai-chat')" class="bg-white text-hope-700 hover:bg-hope-50 font-semibold px-6 py-3 rounded-xl shadow-lg transition flex items-center space-x-2">
                            <i class="fa-solid fa-comments"></i>
                            <span>Trò chuyện ngay với AI</span>
                        </button>
                        <button onclick="switchTab('report')" class="bg-hope-900/40 hover:bg-hope-900/60 text-white border border-white/20 font-semibold px-6 py-3 rounded-xl transition flex items-center space-x-2">
                            <i class="fa-solid fa-shield-halved"></i>
                            <span>Báo cáo sự việc ẩn danh</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Core Features Grid -->
            <div>
                <h3 class="text-xl font-bold text-slate-900 mb-6 flex items-center space-x-2">
                    <i class="fa-solid fa-compass text-hope-600"></i>
                    <span>Các tính năng hỗ trợ toàn diện</span>
                </h3>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                    <div onclick="switchTab('ai-chat')" class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-md hover:border-hope-300 transition cursor-pointer group">
                        <div class="w-12 h-12 rounded-xl bg-hope-100 text-hope-600 flex items-center justify-center text-xl mb-4 group-hover:scale-110 transition">
                            <i class="fa-solid fa-robot"></i>
                        </div>
                        <h4 class="font-bold text-slate-900 mb-2">Trợ lý AI Tâm lý</h4>
                        <p class="text-sm text-slate-600 leading-relaxed">Tâm sự, nhận lời khuyên ẩn danh 24/7 và hướng dẫn xử lý khủng hoảng tức thì.</p>
                    </div>

                    <div onclick="switchTab('report')" class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-md hover:border-hope-300 transition cursor-pointer group">
                        <div class="w-12 h-12 rounded-xl bg-amber-100 text-amber-600 flex items-center justify-center text-xl mb-4 group-hover:scale-110 transition">
                            <i class="fa-solid fa-user-secret"></i>
                        </div>
                        <h4 class="font-bold text-slate-900 mb-2">Báo Cáo Ẩn Danh</h4>
                        <p class="text-sm text-slate-600 leading-relaxed">Gửi tố giác an toàn, được mã hóa thông tin, theo dõi trạng thái qua mã định danh.</p>
                    </div>

                    <div onclick="switchTab('toolkits')" class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-md hover:border-hope-300 transition cursor-pointer group">
                        <div class="w-12 h-12 rounded-xl bg-teal-100 text-teal-600 flex items-center justify-center text-xl mb-4 group-hover:scale-110 transition">
                            <i class="fa-solid fa-book-open-reader"></i>
                        </div>
                        <h4 class="font-bold text-slate-900 mb-2">Bộ Công Cụ & Kịch Bản</h4>
                        <p class="text-sm text-slate-600 leading-relaxed">Tài liệu xử lý riêng biệt dành cho học sinh, giáo viên và phụ huynh.</p>
                    </div>

                    <div onclick="switchTab('quiz')" class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-md hover:border-hope-300 transition cursor-pointer group">
                        <div class="w-12 h-12 rounded-xl bg-purple-100 text-purple-600 flex items-center justify-center text-xl mb-4 group-hover:scale-110 transition">
                            <i class="fa-solid fa-clipboard-question"></i>
                        </div>
                        <h4 class="font-bold text-slate-900 mb-2">Trắc Nghiệm Tâm Lý</h4>
                        <p class="text-sm text-slate-600 leading-relaxed">Kiểm tra mức độ tổn thương, tự đánh giá nguy cơ và nhận định hướng hành động.</p>
                    </div>
                </div>
            </div>

            <!-- Emergency Support Banner -->
            <div class="bg-amber-50 border border-amber-200 rounded-2xl p-6 flex flex-col sm:flex-row items-center justify-between gap-4">
                <div class="flex items-center space-x-4">
                    <div class="w-12 h-12 rounded-full bg-amber-100 text-amber-600 flex items-center justify-center text-2xl flex-shrink-0">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                    </div>
                    <div>
                        <h4 class="font-bold text-amber-900">Bạn đang gặp nguy hiểm hoặc cần can thiệp khẩn cấp?</h4>
                        <p class="text-xs sm:text-sm text-amber-800">Đừng chịu đựng một mình. Hãy liên hệ ngay với cơ quan chức năng hoặc thầy cô giáo chủ nhiệm.</p>
                    </div>
                </div>
                <div class="flex flex-shrink-0 space-x-2">
                    <a href="tel:111" class="bg-amber-600 hover:bg-amber-700 text-white font-medium px-4 py-2.5 rounded-xl text-sm transition shadow-sm">
                        <i class="fa-solid fa-phone mr-1"></i> Tổng đài 111
                    </a>
                </div>
            </div>
        </section>

        <!-- TAB 2: AI COUNSELOR CHAT -->
        <section id="tab-ai-chat" class="tab-content hidden flex-1 flex flex-col h-[calc(100vh-8rem)]">
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm flex flex-col flex-1 overflow-hidden">
                <!-- Chat Header -->
                <div class="p-4 border-b border-slate-200 bg-slate-50 flex items-center justify-between">
                    <div class="flex items-center space-x-3">
                        <div class="relative">
                            <div class="w-10 h-10 rounded-full bg-hope-600 text-white flex items-center justify-center font-bold">
                                <i class="fa-solid fa-robot"></i>
                            </div>
                            <span class="absolute bottom-0 right-0 w-3 h-3 bg-emerald-500 border-2 border-white rounded-full"></span>
                        </div>
                        <div>
                            <h3 class="font-bold text-slate-900">Trợ Lý Tâm Lý AI 24/7</h3>
                            <p class="text-xs text-emerald-600 font-medium">Bảo mật tuyệt đối • Thấu hiểu • Không phán xét</p>
                        </div>
                    </div>
                    <button onclick="clearChat()" class="text-xs text-slate-500 hover:text-rose-600 px-3 py-1.5 rounded-lg border border-slate-200 hover:border-rose-200 transition">
                        <i class="fa-solid fa-rotate-right mr-1"></i> Làm mới cuộc trò chuyện
                    </button>
                </div>

                <!-- Quick Prompts / Situations -->
                <div class="p-3 bg-hope-50/50 border-b border-slate-100 flex items-center space-x-2 overflow-x-auto text-xs">
                    <span class="font-semibold text-slate-600 whitespace-nowrap"><i class="fa-solid fa-bolt text-amber-500 mr-1"></i> Gợi ý câu hỏi:</span>
                    <button onclick="sendQuickPrompt('Tôi đang bị bắt nạt hội chứng tẩy chay ở lớp, phải làm sao?')" class="bg-white border border-slate-200 hover:border-hope-500 text-slate-700 px-3 py-1.5 rounded-full whitespace-nowrap transition shadow-xs">Bị tẩy chay ở lớp</button>
                    <button onclick="sendQuickPrompt('Làm sao để đối phó với bạo lực mạng (Cyberbullying)?')" class="bg-white border border-slate-200 hover:border-hope-500 text-slate-700 px-3 py-1.5 rounded-full whitespace-nowrap transition shadow-xs">Bị bạo lực mạng</button>
                    <button onclick="sendQuickPrompt('Tôi chứng kiến bạn cùng lớp bị đánh đập, tôi nên tố giác thế nào an toàn?')" class="bg-white border border-slate-200 hover:border-hope-500 text-slate-700 px-3 py-1.5 rounded-full whitespace-nowrap transition shadow-xs">Tố giác hộ bạn</button>
                    <button onclick="sendQuickPrompt('Con tôi có dấu hiệu ít nói, sợ đến trường sau khi đi học về, tôi cần làm gì?')" class="bg-white border border-slate-200 hover:border-hope-500 text-slate-700 px-3 py-1.5 rounded-full whitespace-nowrap transition shadow-xs">Tư vấn cho phụ huynh</button>
                </div>

                <!-- Chat Messages Area -->
                <div id="chat-messages" class="flex-1 p-4 sm:p-6 overflow-y-auto space-y-4 bg-slate-50/50">
                    <!-- Initial Welcome Message from AI -->
                    <div class="flex items-start space-x-3">
                        <div class="w-8 h-8 rounded-full bg-hope-600 text-white flex items-center justify-center flex-shrink-0 text-sm">
                            <i class="fa-solid fa-robot"></i>
                        </div>
                        <div class="bg-white border border-slate-200 p-4 rounded-2xl rounded-tl-sm max-w-xl shadow-xs text-sm text-slate-700 leading-relaxed">
                            <p class="font-semibold text-slate-900 mb-1">Xin chào! Mình là Trợ lý AI Tâm lý & Hỗ trợ học đường.</p>
                            <p>Mình ở đây để lắng nghe và đồng hành cùng bạn. Mọi chia sẻ của bạn tại đây hoàn toàn <strong>bảo mật và ẩn danh</strong>. Bạn đang gặp phải tình huống khó khăn nào hoặc cần lời khuyên gì, hãy cứ thoải mái chia sẻ nhé!</p>
                        </div>
                    </div>
                </div>

                <!-- Chat Input Form -->
                <div class="p-3 sm:p-4 bg-white border-t border-slate-200">
                    <form id="chat-form" onsubmit="handleChatSubmit(event)" class="flex items-center space-x-2">
                        <input type="text" id="chat-input" placeholder="Nhập tâm sự hoặc câu hỏi của bạn..." 
                            class="flex-1 bg-slate-100 border border-slate-200 focus:border-hope-500 focus:bg-white focus:outline-none rounded-xl px-4 py-3 text-sm transition">
                        <button type="submit" id="chat-submit-btn" class="bg-hope-600 hover:bg-hope-700 text-white px-5 py-3 rounded-xl font-medium text-sm transition shadow-sm flex items-center space-x-1">
                            <span>Gửi</span>
                            <i class="fa-solid fa-paper-plane text-xs"></i>
                        </button>
                    </form>
                    <p class="text-[11px] text-slate-400 text-center mt-2">Trợ lý AI hỗ trợ mô phỏng tâm lý. Trong trường hợp khẩn cấp, vui lòng gọi tổng đài 111 hoặc báo cáo cơ quan nhà trường.</p>
                </div>
            </div>
        </section>

        <!-- TAB 3: ANONYMOUS REPORT HUB -->
        <section id="tab-report" class="tab-content hidden flex-1 flex flex-col space-y-6">
            <div class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 shadow-sm">
                <div class="max-w-3xl mx-auto space-y-6">
                    <div class="text-center space-y-2">
                        <div class="w-12 h-12 bg-amber-100 text-amber-600 rounded-2xl mx-auto flex items-center justify-center text-xl">
                            <i class="fa-solid fa-user-secret"></i>
                        </div>
                        <h3 class="text-2xl font-bold text-slate-900">Hộp Thư Tố Giác & Báo Cáo Ẩn Danh</h3>
                        <p class="text-sm text-slate-600">
                            Gửi thông tin an toàn về các hành vi bạo lực học đường. Hệ thống mã hóa thông tin của bạn để bảo vệ danh tính tuyệt đối trước mọi nguy cơ trả thù.
                        </p>
                    </div>

                    <!-- Report Form -->
                    <form id="report-form" onsubmit="handleReportSubmit(event)" class="space-y-4 pt-4 border-t border-slate-100">
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-xs font-semibold text-slate-700 mb-1">Mức độ khẩn cấp *</label>
                                <select id="report-urgency" required class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:border-hope-500">
                                    <option value="Bình thường">Bình thường (Theo dõi / Đề xuất)</option>
                                    <option value="Cao">Cao (Cần can thiệp sớm trong tuần)</option>
                                    <option value="Khẩn cấp">🚨 Khẩn cấp (Nguy hiểm / Bạo lực đang diễn ra)</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-700 mb-1">Hình thức bạo lực *</label>
                                <select id="report-type" required class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:border-hope-500">
                                    <option value="Bạo lực thể xác">Bạo lực thể xác (Đánh nhau, trấn lột...)</option>
                                    <option value="Bạo lực tinh thần">Bạo lực tinh thần (Lăng mạ, đe dọa, sỉ nhục...)</option>
                                    <option value="Tẩy chay / Cô lập hội chứng">Tẩy chay / Cô lập hội chứng tập thể</option>
                                    <option value="Bạo lực mạng (Cyberbullying)">Bạo lực mạng (Bôi nhọ trên mạng xã hội)</option>
                                    <option value="Khác">Khác</option>
                                </select>
                            </div>
                        </div>

                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">Tên trường học & Lớp học liên quan *</label>
                            <input type="text" id="report-school" required placeholder="Ví dụ: Trường THPT Chu Văn An, Lớp 10A1" 
                                class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:border-hope-500">
                        </div>

                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">Mô tả chi tiết sự việc (Ai, Khi nào, Ở đâu, Diễn biến) *</label>
                            <textarea id="report-details" required rows="4" placeholder="Hãy mô tả chi tiết nhất có thể để nhà trường hoặc cơ quan có thẩm quyền hỗ trợ chính xác..."
                                class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:border-hope-500"></textarea>
                        </div>

                        <div class="bg-slate-50 p-4 rounded-xl border border-slate-200 flex items-start space-x-3">
                            <input type="checkbox" id="report-consent" required class="mt-1 rounded text-hope-600 focus:ring-hope-500">
                            <label for="report-consent" class="text-xs text-slate-600">
                                Tôi cam kết thông tin báo cáo là trung thực. Tôi hiểu rằng hệ thống sẽ ẩn danh tính của tôi hoàn toàn và cấp cho tôi một mã số tra cứu riêng biệt.
                            </label>
                        </div>

                        <button type="submit" class="w-full bg-hope-600 hover:bg-hope-700 text-white font-medium py-3 rounded-xl transition shadow-sm text-sm">
                            <i class="fa-solid fa-lock mr-2"></i> Gửi Báo Cáo An Toàn & Mã Hóa
                        </button>
                    </form>

                    <!-- Report Tracking Lookup Box -->
                    <div class="mt-10 pt-8 border-t border-slate-200">
                        <h4 class="font-bold text-slate-900 mb-2 flex items-center space-x-2">
                            <i class="fa-solid fa-magnifying-glass text-hope-600"></i>
                            <span>Tra cứu trạng thái báo cáo</span>
                        </h4>
                        <p class="text-xs text-slate-600 mb-4">Nhập mã định danh (mã code) bạn nhận được sau khi gửi báo cáo để kiểm tra quá trình xử lý.</p>
                        <div class="flex space-x-2">
                            <input type="text" id="lookup-code" placeholder="Ví dụ: RPT-8942-XN" 
                                class="flex-1 bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:border-hope-500 uppercase">
                            <button onclick="lookupReport()" class="bg-slate-800 hover:bg-slate-900 text-white px-5 py-2.5 rounded-xl text-sm font-medium transition">
                                Tra cứu
                            </button>
                        </div>
                        <div id="lookup-result" class="mt-4"></div>
                    </div>
                </div>
            </div>
        </section>

