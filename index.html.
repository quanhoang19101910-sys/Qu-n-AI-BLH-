        // --- TOOLKITS SWITCHER ---
        function switchToolkit(role) {
            document.querySelectorAll('.tk-content').forEach(el => el.classList.add('hidden'));
            document.getElementById('tk-content-' + role).classList.remove('hidden');

            document.querySelectorAll('.tk-btn').forEach(btn => {
                btn.classList.remove('bg-hope-600', 'text-white', 'shadow-sm');
                btn.classList.add('bg-slate-200', 'text-slate-700');
            });
            const activeBtn = document.getElementById('tk-btn-' + role);
            if (activeBtn) {
                activeBtn.classList.remove('bg-slate-200', 'text-slate-700');
                activeBtn.classList.add('bg-hope-600', 'text-white', 'shadow-sm');
            }
        }


        // --- WELL-BEING QUIZ LOGIC ---
        const quizQuestions = [
            {
                question: "1. Bạn có cảm giác lo lắng, hồi hộp hoặc sợ hãi mỗi khi chuẩn bị bước chân đến cổng trường không?",
                options: [
                    { text: "Không bao giờ hoặc hiếm khi", score: 0 },
                    { text: "Thỉnh thoảng có vào một số ngày", score: 1 },
                    { text: "Thường xuyên và rất căng thẳng", score: 2 }
                ]
            },
            {
                question: "2. Bạn có từng bị bạn bè trêu chọc quá mức, đặt biệt danh ác ý, lăng mạ hoặc cô lập khỏi các hoạt động chung?",
                options: [
                    { text: "Không có", score: 0 },
                    { text: "Có vài lần nhưng đã qua", score: 1 },
                    { text: "Thường xuyên xảy ra khiến tôi tổn thương", score: 2 }
                ]
            },
            {
                question: "3. Bạn có nhận được các tin nhắn, bình luận đe dọa, chế nhạo hoặc bôi nhọ trên mạng xã hội?",
                options: [
                    { text: "Không bao giờ", score: 0 },
                    { text: "Đã từng gặp vài lần", score: 1 },
                    { text: "Liên tục bị làm phiền, xúc phạm online", score: 2 }
                ]
            },
            {
                question: "4. Sức khỏe và giấc ngủ của bạn gần đây như thế nào?",
