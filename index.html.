        function lookupReport() {
            const codeInput = document.getElementById('lookup-code').value.trim().toUpperCase();
            const resultBox = document.getElementById('lookup-result');

            if (!codeInput) {
                resultBox.innerHTML = `<p class="text-xs text-rose-600">Vui lòng nhập mã tra cứu hợp lệ.</p>`;
                return;
            }

            const report = dummyReportsDB[codeInput];
            if (report) {
                resultBox.innerHTML = `
                    <div class="bg-slate-50 border border-slate-200 p-4 rounded-xl space-y-2 text-xs">
                        <div class="flex justify-between items-center">
                            <span class="font-bold text-slate-900">Mã: ${report.code}</span>
                            <span class="bg-hope-100 text-hope-700 px-2 py-0.5 rounded font-medium">${report.urgency}</span>
                        </div>
                        <p><strong>Loại:</strong> ${report.type}</p>
                        <p><strong>Trường:</strong> ${report.school}</p>
                        <p><strong>Ngày gửi:</strong> ${report.date}</p>
                        <div class="pt-2 border-t border-slate-200 flex items-center space-x-2 text-emerald-700 font-medium">
                            <i class="fa-solid fa-circle-check"></i>
                            <span>Trạng thái: ${report.status}</span>
                        </div>
                    </div>
                `;
            } else {
