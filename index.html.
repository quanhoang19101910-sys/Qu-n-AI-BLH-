                    </div>
                </div>
            `;
        }

        // Gemini API integration function
        async function callGeminiAI(prompt) {
            const systemPrompt = "Bạn là một Chuyên gia Tư vấn Tâm lý học đường và Trợ lý AI đồng cảm, thấu hiểu, ân cần chuyên chống bạo lực học đường. Hãy đưa ra lời khuyên thiết thực, an toàn, bảo mật, động viên tinh thần và hướng dẫn các bước xử lý cụ thể cho học sinh, phụ huynh hoặc giáo viên bằng tiếng Việt.";
            const apiKey = ""; 
            const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;

            const payload = {
                contents: [{ parts: [{ text: prompt }] }],
                systemInstruction: { parts: [{ text: systemPrompt }] }
            };

            const response = await fetch(apiUrl, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            const result = await response.json();
            const candidate = result.candidates?.[0];
            if (candidate && candidate.content?.parts?.[0]?.text) {
                return candidate.content.parts[0].text;
            } else {
                throw new Error("Invalid API response");
            }
        }

        function getFallbackSimulatedResponse(query) {
            const q = query.toLowerCase();
            if (q.includes('tẩy chay') || q.includes('cô lập')) {
                return "Mình rất hiểu cảm giác tủi thân và cô đơn khi bị hội chứng tẩy chay ở lớp. Xin bạn hãy nhớ rằng: **Lỗi đó không thuộc về bạn**. \n\n1. Đừng cố gắng lấy lòng những kẻ đang cố tình cô lập bạn. \n2. Hãy tìm kiếm những người bạn chân thành khác ở câu lạc bộ, lớp bên cạnh hoặc giữ khoảng cách an toàn.\n3. Hãy chia sẻ ngay với giáo viên chủ nhiệm hoặc phụ huynh để nhà trường có biện pháp can thiệp uốn nắn hành vi của các bạn trong lớp.";
            } else if (q.includes('mạng') || q.includes('cyberbullying') || q.includes('tin nhắn')) {
                return "Bạo lực trên không gian mạng có sức sát thương tinh thần rất lớn. \n\n1. **Tuyệt đối không bình luận đôi co hay trả đũa.** \n2. Hãy chụp lại toàn bộ màn hình (screenshot) các tin nhắn, bài đăng lăng mạ làm bằng chứng xác thực.\n3. Sử dụng tính năng chặn (block) và báo cáo vi phạm (report) trên nền tảng mạng xã hội.\n4. Đưa bằng chứng này cho phụ huynh hoặc thầy cô giáo để nhà trường có cơ sở pháp lý xử lý nghiêm.";
            } else if (q.includes('tố giác') || q.includes('nhìn thấy') || q.includes('bạn cùng lớp')) {
                return "Bạn là một người rất dũng cảm và có lòng trắc ẩn khi muốn giúp đỡ bạn mình! \n\n1. Bạn không cần phải trực tiếp lao vào can ngăn nếu việc đó gây nguy hiểm cho chính bạn.\n2. Hãy sử dụng **Hộp Thư Tố Giác Ẩn Danh** trên trang web này để gửi thông tin chính xác về sự việc đến ban giám hiệu.\n3. Hoặc bạn có thể báo trực tiếp cho thầy cô giáo chủ nhiệm hoặc giám thị mà bạn tin tưởng nhất.";
            } else if (q.includes('phụ huynh') || q.includes('con tôi') || q.includes('dấu hiệu')) {
                return "Cảm ơn bậc phụ huynh đã quan tâm đến sự an toàn của con. Khi trẻ có biểu hiện sợ đi học, sa sút tinh thần, cha mẹ nên:\n\n1. Tạo không gian ấm cúng, ân cần trò chuyện để con cảm thấy an toàn tuyệt đối.\n2. Ghi nhận cảm xúc của con, tuyệt đối không quở trách hay đổ lỗi cho con.\n3. Hẹn gặp trực tiếp giáo viên chủ nhiệm hoặc Ban Giám Hiệu nhà trường để yêu cầu làm rõ và bảo vệ an toàn cho con.";
            } else {
                return "Cảm ơn bạn đã chia sẻ cùng mình. Mọi tổn thương hay khó khăn bạn đang trải qua đều rất đáng được lắng nghe và tôn trọng.\n\nTrong mọi tình huống bạo lực, xin hãy ghi nhớ:\n- **Bạn không đơn độc.**\n- **Bạn hoàn toàn có quyền được bảo vệ an toàn.**\n- Hãy cân nhắc sử dụng tính năng Báo Cáo Ẩn Danh hoặc liên hệ tổng đài bảo vệ trẻ em 111 để được hỗ trợ kịp thời nhé!";
            }
        }

        function formatAIResponse(text) {
            return escapeHtml(text).replace(/\n/g, '<br>').replace(/\*\*(.*?)\*\*/g, '<strong class="font-bold text-slate-900">$1</strong>');
        }

        function escapeHtml(text) {
            const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
            return text.replace(/[&<>"']/g, function(m) { return map[m]; });
        }


        // --- ANONYMOUS REPORT LOGIC ---
        const dummyReportsDB = {};

